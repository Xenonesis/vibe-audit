{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vibe Audit eval corpus",
  "type": "object",
  "required": [
    "skill_name",
    "schema_version",
    "evals"
  ],
  "properties": {
    "skill_name": {
      "const": "vibe-audit"
    },
    "schema_version": {
      "type": "string"
    },
    "evals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "prompt",
          "expected_output",
          "files",
          "assertions"
        ],
        "properties": {
          "id": {
            "type": [
              "integer",
              "string"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "expected_output": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
